# 仓库内统一按文本处理，换行以 LF 存储
* text=auto

# Gradle Wrapper 的 shell 脚本必须是 LF，否则 Linux / macOS 上执行会报
# "/bin/sh^M: bad interpreter"
gradlew text eol=lf
gradlew.bat text eol=crlf

# Windows 批处理保持 CRLF
*.bat text eol=crlf

# 二进制文件不做换行转换
*.jar binary
*.apk binary
*.aab binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ttf binary
*.otf binary
